# Link-preview bots (WhatsApp, Facebook / Instagram DM, Telegram, ...) can't run the chat app, so
# for them /o/<slug> is proxied to the backend's Open Graph page (page 07 "Pratinjau link
# outlet", GET /api/v1/public/o/{slug}/share). People always get the SPA. Not matched on purpose:
# "Instagram" / "FBAN" — those are the in-app browsers of real people (Instagram previews are
# fetched by facebookexternalhit).
map $http_user_agent $link_preview_bot {
    default 0;
    "~*(facebookexternalhit|facebookcatalog|meta-externalagent|WhatsApp/|TelegramBot|Twitterbot|Slackbot|LinkedInBot|Discordbot|Pinterestbot|SkypeUriPreview|Googlebot|bingbot|Applebot|redditbot|Embedly|vkShare)" 1;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Hashed build assets: cache for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Outlet link /o/<slug> (C1): the SPA, or the link preview for preview bots.
    location ~ ^/o/[^/]+/?$ {
        add_header Cache-Control "no-cache";
        if ($link_preview_bot) {
            rewrite ^/o/([^/]+)/?$ /__link-preview/$1 last;
        }
        try_files /index.html =404;
    }

    location ~ ^/__link-preview/(?<preview_slug>[A-Za-z0-9-]{1,64})$ {
        internal;
        # API_ORIGIN = the backend's public URL (Dockerfile: from VITE_API_BASE_URL). A variable in
        # proxy_pass needs a resolver; the image fills NGINX_LOCAL_RESOLVERS from resolv.conf.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=60s ipv6=off;
        proxy_pass ${API_ORIGIN}/api/v1/public/o/$preview_slug/share;
        proxy_ssl_server_name on;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        # Backend down, rate limited or not configured: the bot gets the SPA (generic "Thinker").
        proxy_intercept_errors on;
        error_page 429 500 502 503 504 = @spa;
    }

    location @spa {
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    # SPA: every other path falls back to index.html (never cached, so deploys show at once).
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
