# Admin web app configuration (Vite: only VITE_* reach the browser, so never put secrets here).
# Local: copy to admin/.env.local. Hosted (Vercel / Cloudflare Pages): set as build env vars.
# All three are required; the app shows a configuration error screen if any is invalid.

# FastAPI backend base URL: http://localhost:8000 locally, the Railway API domain when hosted.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project, used for sign-in only (the app never reads tables through Supabase).
# Project URL: Dashboard → Project Settings → API → Project URL.
VITE_SUPABASE_URL=https://<ref>.supabase.co
# Public key: Project Settings → API Keys → anon / publishable key (safe to expose).
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
