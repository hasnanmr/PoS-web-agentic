# Admin web app configuration. Copy to admin/.env.local for local development.
# All three are required; the app shows a configuration error screen if any is invalid.

# FastAPI backend base URL (backend runs on :8000 locally).
VITE_API_BASE_URL=http://localhost:8000

# Supabase project (Project Settings > API). Not set up yet: these placeholders let the
# shell run locally until T-006 wires up Supabase Auth.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
