# Backend configuration. Copy to backend/.env for local development.
# In APP_ENV=local only APP_ENV is needed; demo/staging/production require
# DATABASE_URL, SUPABASE_URL, SUPABASE_JWKS_URL, SUPABASE_JWT_ISSUER and RABBITMQ_URL.

# local | demo | staging | production
APP_ENV=local
LOG_LEVEL=INFO
PORT=8000

# Local docker services (docker-compose.yml, Makefile). Local-only throwaway values;
# this file is the single place they live. APP_BACKEND_DB_PASSWORD must match the
# password in DATABASE_URL below (`make db-reset` sets it on role app_backend).
LOCAL_POSTGRES_PASSWORD=pos
LOCAL_RABBITMQ_PASSWORD=guest
APP_BACKEND_DB_PASSWORD=app_backend_local

# Postgres, connecting as role app_backend so RLS applies (never a superuser/owner).
# Local: `make db-reset` creates the schema in the docker compose database and sets this
# password. Hosted: Supabase transaction pooler (port 6543), user app_backend (T-113),
# e.g. postgresql://app_backend.<ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=postgresql://app_backend:app_backend_local@localhost:5432/pos
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# Supabase Auth (JWT verification). Not set up yet; fill in once the project exists.
# JWKS: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# Issuer: https://<ref>.supabase.co/auth/v1
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Asymmetric only; HS256 and none are always rejected.
JWT_ALGORITHMS=ES256,RS256
JWKS_CACHE_SECONDS=600
# Auth admin API only (platform-admin owner invitations, banning deactivated staff).
# Secret: keep in Railway secrets / the operator's machine. Never used for tenant data.
SUPABASE_SERVICE_ROLE_KEY=

# RabbitMQ (WhatsApp queues). Local: docker compose service.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# IANA time zone used for business days, reports and reminders (WIB).
DEFAULT_TIMEZONE=Asia/Jakarta

# Comma-separated list of admin web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
