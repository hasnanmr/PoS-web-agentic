# Backend configuration (FastAPI API + worker).
# Local: copy to backend/.env. Hosted (Railway): set the same names as service variables.
# APP_ENV=local needs nothing else to boot; demo/staging/production refuse to start
# without DATABASE_URL, SUPABASE_URL, SUPABASE_JWKS_URL, SUPABASE_JWT_ISSUER.
# RABBITMQ_URL and WHATSAPP_* are optional for the API (the WhatsApp webhook answers 503
# without them); the WhatsApp worker refuses to start without DATABASE_URL, and idles on
# standby without RABBITMQ_URL or WHATSAPP_ACCESS_TOKEN.
# <ref> below = your Supabase project ref (Project Settings → General → Project ID).

# local | demo | staging | production
APP_ENV=local
LOG_LEVEL=INFO
PORT=8000

# ─── Local docker services (docker-compose.yml, Makefile) ─────────────────────────
# Local-only throwaway values; this file is the single place they live.
# APP_BACKEND_DB_PASSWORD must match the password in the local DATABASE_URL below
# (`make db-reset` sets it on role app_backend).
LOCAL_POSTGRES_PASSWORD=pos
LOCAL_RABBITMQ_PASSWORD=guest
APP_BACKEND_DB_PASSWORD=app_backend_local

# ─── Database ───────────────────────────────────────────────────────────────────────
# Always role app_backend so RLS applies (never postgres / service role).
# Local:  the docker compose database.
# Supabase: Dashboard → Connect → "Transaction pooler" (port 6543). Copy that URL, then
#   change the user to app_backend.<ref> and the password to the one set by
#   `alter role app_backend password '…'` (docs/operations/supabase-provisioning.md step 7).
#   Host …pooler.supabase.com, port 6543, database postgres.
DATABASE_URL=postgresql://app_backend:app_backend_local@localhost:5432/pos
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# ─── Supabase Auth ──────────────────────────────────────────────────────────────────
# Project URL: Dashboard → Project Settings → API → Project URL.
# Empty = auth disabled (local shell only). Example: https://<ref>.supabase.co
SUPABASE_URL=
# JWT verification with the project's asymmetric signing keys (Auth → JWT Keys).
#   SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
#   SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Asymmetric only; HS256 and none are always rejected.
JWT_ALGORITHMS=ES256,RS256
JWKS_CACHE_SECONDS=600
# Secret key: Project Settings → API Keys → Secret keys (sb_secret_…; the legacy
# service_role JWT key is disabled on our project). Used ONLY for the Auth admin API
# (owner invitations via the CLI, staff invitations, banning deactivated staff) and for
# private Storage objects (menu photos: upload, signed URLs, removal). Never for tenant
# table data. Keep it in Railway secrets.
SUPABASE_SERVICE_ROLE_KEY=
# Where invitation emails send people to set their password: the admin app URL.
# Also add it under Auth → URL Configuration → Redirect URLs.
ADMIN_APP_URL=http://localhost:5170

# ─── RabbitMQ ───────────────────────────────────────────────────────────────────────
# Local: docker compose service. Railway: the rabbitmq service's private URL.
# API (webhook publisher) and WhatsApp worker both need it.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ─── WhatsApp Cloud API (Meta) ──────────────────────────────────────────────────────
# developers.facebook.com → your app. Test number works without business verification.
# App secret: App settings → Basic → App secret (API: verifies X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Any string you choose; enter the same value under WhatsApp → Configuration → Webhook
# (callback URL https://<backend>/webhooks/whatsapp, subscribe to the "messages" field).
WHATSAPP_VERIFY_TOKEN=
# Worker only: permanent System User token (Business settings → System users) with
# whatsapp_business_messaging. The 24-hour token from API Setup works for a quick test.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v23.0
# Map an outlet to its number (phone number id from WhatsApp → API Setup):
#   uv run python -m app.cli whatsapp-connect --outlet <uuid> --phone-number-id <id>

# ─── Misc ───────────────────────────────────────────────────────────────────────────
# IANA time zone used for business days, reports and reminders (WIB).
DEFAULT_TIMEZONE=Asia/Jakarta
# Comma-separated admin web origins allowed to call the API (add the hosted admin URL).
CORS_ORIGINS=http://localhost:5170,http://localhost:4170
