brag-output*/

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Environment files (templates are *.env.example)
.env
.env.*
!.env.example
*.local

# Python (backend)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node (admin)
node_modules/
dist/
coverage/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# NOTE: backend/app/BUILD_SHA and admin/public/version.txt (commit stamps written by CI right
# before `railway up`) must NOT be listed here: `railway up` skips gitignored files, and the
# post-deploy smoke test needs them in the build. They only ever exist on the CI runner.
